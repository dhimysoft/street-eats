# Copy this file to server/.env and fill in the values from your Render
# PostgreSQL instance's "Connections" panel. PGHOST must be the EXTERNAL
# hostname, e.g. dpg-xxxxxxxx-a.oregon-postgres.render.com
PGDATABASE=""
PGHOST=""
PGPASSWORD=""
PGPORT=5432
PGUSER=""

# Leave unset for Render (SSL required). Set to false only when pointing
# at a local Postgres that doesn't speak SSL.
# PGSSL=false
